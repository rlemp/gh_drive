


#!/bin/bash

# ==============================================================================
# Configuration & Localisation
# ==============================================================================
readonly BROWSER_DEFAULT="firefox"
readonly PRIVATE_FLAG="--private-window"

# ==============================================================================
# Fonctions Utilitaires (Programmation défensive)
# ==============================================================================
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# ==============================================================================
# Base de données des services (Mapping URLs)
# ==============================================================================
declare -A SERVICES=(
    # --- Gestion de Compte & Sécurité ---
    ["connections"]="https://myaccount.google.com/connections?filters=3,4&hl=fr" # Services tiers [cite: 1]
    ["security"]="https://myaccount.google.com/security-checkup/2"              # Checkup sécurité [cite: 1]
    ["takeout"]="https://takeout.google.com/"                                   # Google Takeout [cite: 1]
    ["passwords"]="https://passwords.google.com/"                               # Google Passwords [cite: 1]
    ["storage"]="https://one.google.com/storage?hl=fr"                          # Stockage Google One [cite: 1]
    ["activity"]="https://myactivity.google.com/myactivity"                     # Activité Google [cite: 1]
    ["dashboard"]="https://myaccount.google.com/dashboard"                      # Dashboard [cite: 1]
    ["profile"]="https://myaccount.google.com/profile"                          # Mon profil [cite: 1]
    ["gmail"]="https://www.labnol.org/internet/gmail-search-tips/29206"  # recherche dans gmail 
    
    # --- Outils de Recherche & Analyse ---
    ["factcheck"]="https://toolbox.google.com/factcheck/markuptool"             # Fact Check Tool [cite: 1]
    ["trends"]="https://trends.google.com/trends/"                              # Google Trends [cite: 1]
    ["scholar"]="https://scholar.google.ch/"                                    # Google Scholar [cite: 1]
    ["books"]="https://books.google.com/"                                       # Google Books [cite: 1]
    ["wolfram"]="https://www.wolframalpha.com/input/?i=french"                  # Wolfram Alpha [cite: 1, 2]
    
    # --- Confidentialité & Utilitaires ---
    ["webkay"]="https://webkay.robinlinus.com/"                                 # Ce que sait le navigateur [cite: 1]
    ["superlogout"]="https://superlogout.com/"                                  # Déconnexion massive [cite: 1]
    ["deleteme"]="https://backgroundchecks.org/justdeleteme/"                   # Supprimer compte [cite: 1]
    ["deepweb"]="https://deep-web.org/how-to-research/deep-web-search-engines/" # Recherche Deep Web [cite: 1]
    ["yandex"]="https://passport.yandex.com/"                                   # Yandex Auth [cite: 1]
    ["checkurl"]="https://www.bitdefender.com/en-us/consumer/link-checker"                       # ckeck malware phishing url
    ["checkshorturl"]="https://checkshorturl.com/"                       # ckeck shortg url
)

# ==============================================================================
# Affichage & Menu
# ==============================================================================
show_menu() {
    cat << _EOF_
    
    Gestion Google & Recherche :
    ----------------------------------------------------------------------------
    connections | security | takeout | passwords | storage  | activity
    dashboard   | profile  | trends  | scholar   | books    | factcheck | gmail	
    
    Outils Externes & Vie Privée :
    ----------------------------------------------------------------------------
    webkay        | superlogout | deleteme | deepweb | yandex | wolfram | checkurl
    checkshorturl |
    
_EOF_
}

# ==============================================================================
# Exécution Principale
# ==============================================================================
main() {
    show_menu
    
    while true; do
        read -p "Votre choix : " choice
        
        # Vérification si le choix existe dans le tableau
        if [[ -n "${SERVICES[$choice]}" ]]; then
            local url="${SERVICES[$choice]}"
            
            # Application de la programmation défensive pour le binaire
            if command_exists "$BROWSER_DEFAULT"; then
                echo "Ouverture de $choice..."
                
                # Exemple de condition spécifique : navigation privée pour la vie privée
                if [[ "$choice" == "webkay" || "$choice" == "superlogout" ]]; then
                    "$BROWSER_DEFAULT" "$PRIVATE_FLAG" "$url"
                else
                    "$BROWSER_DEFAULT" "$url"
                fi
                break
            else
                echo "Erreur : $BROWSER_DEFAULT non trouvé sur le système."
                exit 1
            fi
        else
            echo "Choix invalide. Veuillez réessayer."
        fi
    done
}

main "$@"



