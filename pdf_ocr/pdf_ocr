		#	# Convertir l'image-text.jpg en PDF consultable
		#	# Creation d' un fichier output.pdf consultable 
		#+++++++++++++++++++++++++++++++++++++++++++++

		#!/bin/bash
		# Conversion d'une image-texte (JPEG) en PDF avec le texte sous-jacent en Bash

		convert image-text.jpg -density 300 -depth 8 image.tif  # ou convert image-text.png -density 300 -depth 8 image.tif
		tesseract image.tif output -l eng  # fra  genere un ouput.txt
		tesseract image.tif output -l eng pdf # genere un pdf avec texte sous-jacent
		
