# Fonction d'ouverture propre
open_target() {
    local key=$1
    # Nettoyage des caractères potentiels (espaces, virgules, crochets)
    key=$(echo "$key" | tr -d '[],')
    
    if [[ -n "${DOCS[$key]}" ]]; then
        echo "Ouverture de $key..."
        "$BROWSER_DEFAULT" "${DOCS[$key]}"
    else
        echo "Erreur : '$key' non reconnu."
    fi
}

main() {
    # ÉTAPE 1 : Vérifier si des arguments sont passés directement au script
    if [[ $# -gt 0 ]]; then
        for arg in "$@"; do
            open_target "$arg"
        done
        exit 0
    fi

    # ÉTAPE 2 : Vérifier s'il y a une entrée via un PIPE (stdin)
    if [[ ! -t 0 ]]; then
        while read -r line; do
            # Sépare la ligne par espaces ou virgules pour gérer [dj,gold]
            for word in ${line//,/ }; do
                open_target "$word"
            done
        done
        exit 0
    fi

    # ÉTAPE 3 : Sinon, mode interactif classique
    show_menu
    read -p "Votre choix : " choice
    open_target "$choice"
}

main "$@"
