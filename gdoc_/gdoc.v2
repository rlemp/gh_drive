# ==============================================================================
# Configuration & Localisation
# ==============================================================================
readonly BROWSER_DEFAULT="firefox"

# ==============================================================================
# Fonctions Utilitaires (Programmation défensive)
# ==============================================================================
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# ==============================================================================
# Base de données des documents (Mapping URLs) 
# ==============================================================================
declare -A DOCS=(
    ["gold"]="https://docs.google.com/spreadsheets/d/1rh8ySlkbhaty-33CThK8Y0lTEoaobVdQtEfmLT6lASI/edit?gid=4#gid=4"
    ["portfol"]="https://docs.google.com/spreadsheets/d/1WHr6bj3LzmdAY9R4nF9hqDVETRgI8YHHDT6M6Ed40EM/edit#gid=2"
    ["battery"]="https://docs.google.com/spreadsheets/d/1bOJ0MoRht3XLg60AF_nWqw0oRT2VHP3r2xJ1mu_6TeM/edit?usp=sharing"
    ["arch_px"]="https://docs.google.com/spreadsheets/d/1saSg1-NotYCROy5ym45sqbW_HaQjPn47Gu9r1t8BrcQ/edit#gid=1648040601"
    ["usd_ichi"]="https://docs.google.com/spreadsheets/d/1U7i3ZUErBCkCq1YANijIOaj4N23MrkjzC25a9R_UaZs/edit?gid=0#gid=0"
    ["synops"]="https://docs.google.com/spreadsheets/d/1X5fHpfEdPosb5vUsD75eTwrD5UXIEZzXob-hI6u1ZNM/edit#gid=0"
    ["energie"]="https://docs.google.com/spreadsheets/d/1n2V83ZmMP5Bw4unmH3yKUXHuMrg3AMUW0kaM6h8cc-k/edit?usp=sharing"
    ["dep"]="https://docs.google.com/spreadsheets/d/1AK_-Dy7gjW57oDYQWmMHgdWkL9eIbhhgsMaRBU-g6n8/edit?usp=sharing"
    ["dj"]="https://docs.google.com/spreadsheets/d/1F4opmdoVsjFQSm2uGIYb4KZF5-7HY8orB0XhaHjTamU/edit#gid=862585490"
    ["usd"]="https://docs.google.com/spreadsheets/d/1iILV-CYCRL3QzYw4OMDrpulIVklA0kMh8ITfsFzrNKk/edit?gid=0#gid=0"
    ["nikkei"]="https://docs.google.com/spreadsheets/d/1nMMjMlp3rJnHv2b00rSLVfP32L6Zo141S-WY6FoqGxQ/edit?gid=751490571#gid=751490571"
    ["asj"]="https://docs.google.com/spreadsheets/d/1-S8AoMXHQ5kwvW1blVPMHdvEno7ypgQUDclLluU1aLk/edit?gid=1502691496#gid=1502691496"
)

# ==============================================================================
# Affichage & Menu
# ==============================================================================
show_menu() {
    cat << _EOF_
    
    Accès rapide Google Documents :
    ----------------------------------------------------------------------------
    gold     | portfol  | usd_ichi | usd    | nikkei
    battery  | arch_lpx | energie  | dep
    synops   | dj       | asj
    ----------------------------------------------------------------------------
_EOF_
}

