

#!/bin/bash

#++++++++++++ccp version 5++++++++++++++++++++

generate_price_usd() {

local  $yesterday_date $exchange_rate $output_string

yesterday_date=$(date -d "yesterday" +%Y-%m-%d)

exchange_rate=$(curl -s https://www.zonebourse.com/cours/devise/US-DOLLAR-SWISS-FRANC-USD-4597/ | grep '"price":' | awk -F'[:" ]+' '{printf "%.3f", $3}')

output_string="P ${yesterday_date} USD ${exchange_rate} CHF"

echo "${output_string}" | xclip

echo "${output_string}" >>$HOME/.hledger.journal

sed -i "4c$output_string" $HOME/.hledger.directives
}

#+++++++++++++update journal trie+++++++++++++++++

update_journal_trie() {

local $RAW $TRIE 

RAW="$HOME/.hledger.journal"
TRIE="$HOME/.hledger.journal_trie"

hledger -f "$RAW" print > "$TRIE"
}

#++++++fonction display++++++++++++++++

# Fonction principale pour afficher le menu et exécuter la commande
display() {
    # Variables locales pour éviter les conflits avec le reste du script
    local choix
    local period_arg
    local journal_file="$HOME/.hledger.journal"
    local currency="CHF"
    
    # Vérification de la présence de hledger-ui
    if ! command -v hledger-ui &> /dev/null; then
        echo "Erreur : La commande 'hledger-ui' n'est pas trouvée. Veuillez l'installer."
        return 1
    fi

    # Vérification du fichier journal
    if [ ! -f "$journal_file" ]; then
        echo "Erreur : Le fichier '$journal_file' est introuvable."
        return 1
    fi

    # Affichage du menu
    echo "----------------------------------------"
    echo "Analyse des comptes (hledger-ui)"
    echo "----------------------------------------"
    echo "1. Semaine"
    echo "2. Mois"
    echo "3. Année"
    echo "----------------------------------------"
    
    read -p "Votre choix (1-3) : " choix

    # Traitement du choix avec case ... esac
    case $choix in
        1)
            period_arg="this week"
            ;;
        2)
            period_arg="this month"
            ;;
        3)
            period_arg="this year"
            ;;
        *)
            echo "Choix invalide. Veuillez sélectionner 1, 2 ou 3."
            return 1
            ;;
    esac

    # Exécution de la commande hledger-ui stricte
    # Note: Les arguments 'assets' et 'expencies' sont passés tels quels.
    # Assurez-vous que vos comptes sont bien nommés ainsi dans votre journal.
    echo "Lancement de l'interface UI pour : $period_arg..."
    hledger-ui assets expencies -X "$currency" --period "$period_arg" --all --tree
    
    # Retourne 0 pour indiquer le succès
    return 0
}

#+++++++++++++ main++++++++++++

csv2hledger.sh "$HOME/Téléchargements/"*.csv

mv "$HOME/Téléchargements/"*.csv  "$HOME/Bureau/hledger_labo/csv2hledger/"

generate_price_usd

update_journal_trie

display


















